<?xml version="1.0" encoding="UTF-8"?>
<manifest>
    <!--
      ValkyOS / Motorola Edge 50 Pro (eqe)
      Local manifest overlay for LineageOS 24.0 (Android 17).

      These revisions reproduce the device sources already validated with
      Android 17. Some source branches historically used Android 16 names, but
      compatibility is determined by the exact revisions fixed below.

      Keep this file under .repo/local_manifests/ when using the upstream
      LineageOS/android lineage-24.0 manifest.
    -->

    <remote name="dvy-jp"
            fetch="https://github.com/dvy-jp/" />

    <remote name="valkyos"
            fetch="https://github.com/ValkyOS/" />

    <remote name="grapheneos"
            fetch="https://github.com/GrapheneOS/" />

    <!-- ValkyOS identity, version properties, boot animation, wallpapers and recovery logo (any screen). -->
    <project path="vendor/valkyos"
             name="android_vendor_valkyos"
             remote="valkyos"
             revision="49349ada84b1538414818b9df643b248d0ec3bb2" />

    <!--
      frameworks/av: LineageOS 1c591473 (2026-11-01 security patch) plus
      media/libheif, which Android 16 vendor blobs (eqe WFD) still link against.
    -->
    <remove-project name="LineageOS/android_frameworks_av" />
    <project path="frameworks/av"
             name="android_frameworks_av"
             remote="valkyos"
             groups="pdk,sysui-studio"
             upstream="valkyos-17"
             revision="e2f4322bce9afbc61ec8903fd50e954c3de6cfac" />

    <!--
      frameworks/native: LineageOS a96adf2c (2026-11-01 security patch) plus the
      Sensors permission (GrapheneOS) and the Android 16 display ABI bridge, so no
      setup script has to patch it.
    -->
    <remove-project name="LineageOS/android_frameworks_native" />
    <project path="frameworks/native"
             name="android_frameworks_native"
             remote="valkyos"
             groups="pdk,sysui-studio"
             upstream="valkyos-17"
             revision="fecb116c864c45c523c740f751518b1b3e1af93d" />

    <!--
      Sandboxed Google Play (GmsCompat), ported from GrapheneOS.
      These forks keep the upstream base plus the ValkyOS GmsCompat changes on
      branch valkyos-17. Original work: GrapheneOS (https://grapheneos.org).
    -->
    <remove-project name="LineageOS/android_frameworks_base" />
    <project path="frameworks/base"
             name="android_frameworks_base"
             remote="valkyos"
             groups="pdk-cw-fs,pdk-fs,sysui-studio"
             upstream="valkyos-17"
             revision="fc32a3fc98bdc445ac3a21d75290d7d78975b717" />

    <!-- ValkyOS privacy features in Settings (automatic security reboot toggle). -->
    <remove-project name="LineageOS/android_packages_apps_Settings" />
    <project path="packages/apps/Settings"
             name="android_packages_apps_Settings"
             remote="valkyos"
             groups="pdk-fs,pdk-cw-tvc,sysui-studio"
             upstream="valkyos-17"
             revision="c8d0a929eabd6e4838db1eec887a24cd3b4618e6" />

    <!-- LineageParts: no LineageOS contributors screen in About phone > Legal. -->
    <remove-project name="LineageOS/android_packages_apps_LineageParts" />
    <project path="packages/apps/LineageParts"
