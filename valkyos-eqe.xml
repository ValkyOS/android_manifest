             upstream="valkyos-17"
             revision="c5266f2d617d72cc58907f2f91a51f106a223460" />

    <!-- Updater: shows the ValkyOS version (ro.valkyos.version) in its header. -->
    <remove-project name="LineageOS/android_packages_apps_Updater" />
    <project path="packages/apps/Updater"
             name="android_packages_apps_Updater"
