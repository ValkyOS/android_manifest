<?xml version="1.0" encoding="UTF-8"?>
<manifest>
    <!--
      ValkyOS / Motorola Edge 50 Pro (eqe)
      Local manifest overlay for LineageOS 24.0 (Android 17).

      These revisions reproduce the device sources already validated with
      Android 17. Some source branches historically used Android 16 names, but
      compatibility is determined by the exact revisions fixed below.

      Keep this file under .repo/local_manifests/ when using the upstream
      LineageOS/android lineage-24.0 manifest.
    -->

    <remote name="dvy-jp"
            fetch="https://github.com/dvy-jp/" />

    <remote name="valkyos"
            fetch="https://github.com/ValkyOS/" />

    <remote name="grapheneos"
            fetch="https://github.com/GrapheneOS/" />

    <!-- ValkyOS identity, version properties, boot animation, wallpapers and recovery logo. -->
    <project path="vendor/valkyos"
             name="android_vendor_valkyos"
             remote="valkyos"
             revision="f08d16b56f8998ebd663832bb631793afa266f98" />

    <!-- Exact platform bases required by build/setup-valkyos.sh. -->
    <extend-project name="LineageOS/android_frameworks_av"
                    revision="1c5914737a1a89d0c5b3e52e8289019eab3f8cbf" />

    <extend-project name="LineageOS/android_frameworks_native"
                    revision="a96adf2c6e62dbb22299cd83bbb9ea4bc569e985" />

    <!--
      Sandboxed Google Play (GmsCompat), ported from GrapheneOS.
      These forks keep the upstream base plus the ValkyOS GmsCompat changes on
      branch valkyos-17. Original work: GrapheneOS (https://grapheneos.org).
    -->
    <remove-project name="LineageOS/android_frameworks_base" />
    <project path="frameworks/base"
             name="android_frameworks_base"
             remote="valkyos"
             groups="pdk-cw-fs,pdk-fs,sysui-studio"
             upstream="valkyos-17"
             revision="e557f3b8e11bb2a290d189ccb72642405714c32a" />

    <!-- ValkyOS privacy features in Settings (automatic security reboot toggle). -->
    <remove-project name="LineageOS/android_packages_apps_Settings" />
    <project path="packages/apps/Settings"
             name="android_packages_apps_Settings"
             remote="valkyos"
             groups="pdk-fs,pdk-cw-tvc,sysui-studio"
             upstream="valkyos-17"
             revision="036daed8758223f35f139cf53ecac29709838861" />

    <!-- Contact Scopes (GrapheneOS): scoped contacts provider and permission screen (also Storage Scopes UI). -->
    <remove-project name="LineageOS/android_packages_providers_ContactsProvider" />
    <project path="packages/providers/ContactsProvider"
             name="android_packages_providers_ContactsProvider"
             remote="valkyos"
             groups="pdk-cw-fs,pdk-fs"
             upstream="valkyos-17"
             revision="098825540bb05a8e4516d42c6fc86766368e57f2" />

    <remove-project name="LineageOS/android_packages_modules_Permission" />
    <project path="packages/modules/Permission"
             name="android_packages_modules_Permission"
             remote="valkyos"
             groups="pdk-cw-fs,pdk-fs"
             upstream="valkyos-17"
             revision="ddbae8728439852f558c5951b425e31b2350ab98" />

    <!-- Storage Scopes (GrapheneOS): media and files filtering. -->
    <remove-project name="LineageOS/android_packages_providers_MediaProvider" />
    <project path="packages/providers/MediaProvider"
             name="android_packages_providers_MediaProvider"
             remote="valkyos"
             groups="pdk-cw-fs,pdk-fs,sysui-studio"
             upstream="valkyos-17"
             revision="020be87455a962eefcbdfd0e4b976ade6dec4da5" />

    <remove-project name="LineageOS/android_art" />
    <project path="art"
             name="android_art"
             remote="valkyos"
             groups="pdk"
             upstream="valkyos-17"
             revision="b925f81be11c73c1c74f61339100f52ec184e7d3" />

    <remove-project name="LineageOS/android_bionic" />
    <project path="bionic"
             name="android_bionic"
             remote="valkyos"
             groups="pdk"
             upstream="valkyos-17"
             revision="c7b793d8fd62304a6e072fd16bd22a23bf70974e" />

    <remove-project name="platform/libcore" />
    <project path="libcore"
             name="platform_libcore"
             remote="valkyos"
             groups="pdk,sysui-studio"
             upstream="valkyos-17"
             revision="c708fbd27806ca5e89d35bc05b18d8bbd780a96d" />

    <remove-project name="LineageOS/android_packages_modules_Connectivity" />
    <project path="packages/modules/Connectivity"
             name="android_packages_modules_Connectivity"
             remote="valkyos"
             groups="pdk-cw-fs,pdk-fs"
             upstream="valkyos-17"
             revision="7e2513940bfeb1fddb267bfdc9a24632ef912983" />

    <remove-project name="platform/packages/modules/StatsD" />
    <project path="packages/modules/StatsD"
             name="platform_packages_modules_StatsD"
             remote="valkyos"
             groups="pdk-cw-fs,pdk-fs"
             upstream="valkyos-17"
             revision="c4eb1ae75f746cd6cb8bf810411f099febd29117" />

    <remove-project name="platform/packages/modules/AppSearch" />
    <project path="packages/modules/AppSearch"
             name="platform_packages_modules_AppSearch"
             remote="valkyos"
             groups="pdk"
             upstream="valkyos-17"
             revision="12c2724d9926b7d44a6aa32d30d6a4a8dfd05f01" />

    <remove-project name="platform/system/tools/aidl" />
    <project path="system/tools/aidl"
             name="platform_system_tools_aidl"
             remote="valkyos"
             groups="pdk"
             upstream="valkyos-17"
             revision="56e6698e67174d28d892a9336e91251594eda16a" />

    <!-- Internet connectivity checks setting (GrapheneOS servers by default). -->
    <remove-project name="platform/packages/modules/NetworkStack" />
    <project path="packages/modules/NetworkStack"
             name="platform_packages_modules_NetworkStack"
             remote="valkyos"
             groups="pdk-cw-fs,pdk-fs"
             upstream="valkyos-17"
             revision="60485a1b539343e4f1fd7cb555e04599107a9b1b" />

    <remove-project name="platform/packages/modules/DnsResolver" />
    <project path="packages/modules/DnsResolver"
             name="platform_packages_modules_DnsResolver"
             remote="valkyos"
             groups="pdk-cw-fs,pdk-fs"
             upstream="valkyos-17"
             revision="d217795d09adaab5adf8e5297a1fdcfc0cbe4d1f" />

    <project path="packages/apps/GmsCompat"
             name="platform_packages_apps_GmsCompat"
             remote="valkyos"
             upstream="valkyos-17"
             revision="c9c14e87450f859d4a58f011427f413ad44325a8" />

    <project path="external/GmsCompatConfig"
             name="platform_external_GmsCompatConfig"
             remote="grapheneos"
             revision="774bc68a3a6e949153cd70c457d273466a2e7106" />

    <!--
      GrapheneOS App Store. Follows branch 17 on purpose so a clean sync always
      gets the latest release; the app also updates itself on the device.
    -->
    <project path="external/AppStore"
             name="platform_external_AppStore"
             remote="grapheneos"
             revision="refs/heads/17" />

    <!--
      Vanadium (GrapheneOS browser and WebView), presigned prebuilts. Replaces
      the LineageOS browser and WebView. Follows branch 17 so a clean sync
      always gets the latest release; the App Store also updates it.
      Synced to vendor/vanadium (not external/) because the optional
      android.ext.adservices library is only visible to //vendor in LineageOS;
      this way its Android.bp is used unchanged.
    -->
    <remote name="grapheneos-gitlab"
            fetch="https://gitlab.com/grapheneos/" />

    <project path="vendor/vanadium"
             name="platform_external_vanadium"
             remote="grapheneos-gitlab"
             revision="refs/heads/17"
             clone-depth="1" />

    <!-- Device integration validated with Android 17. -->
    <project path="device/motorola/eqe"
             name="android_device_motorola_eqe"
             remote="dvy-jp"
             revision="77eb7858eaefb87c47b6c418d53231f5202ac70c" />

    <project path="device/qcom/wfd"
             name="android_device_qcom_wfd"
