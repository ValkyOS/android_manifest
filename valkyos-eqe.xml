    <!-- Android 17 vendor sources (a17-ready-v4). -->
    <project path="vendor/motorola/eqe"
             name="proprietary_vendor_motorola_eqe_a17"
             remote="dvy-jp"
             revision="7dad877bfb673cdb0ab14beeeff4d9ec366384ba" />

    <project path="vendor/qcom/wfd"
             name="proprietary_vendor_qcom_wfd_a17"
             remote="dvy-jp"
             revision="2a24489bd2f15d7bb0ae99ecf30c9c408bc9537f" />

    <!-- Android 17 kernel and external modules (a17-ready-v4). -->
    <project path="kernel/motorola/sm7550"
             name="android_kernel_motorola_sm7550_a17"
             remote="dvy-jp"
             revision="8408f2fc8c1a6ee381d6156e4b6cfd7aaea34f0f" />

    <project path="kernel/motorola/sm7550-modules"
             name="android_kernel_motorola_sm7550-modules_a17"
             remote="dvy-jp"
             revision="252f384314a467f70810a2aee2337ec27da55c1f" />

    <project path="kernel/motorola/sm7550-devicetrees"
             name="android_kernel_motorola_sm7550-devicetrees"
             remote="dvy-jp"
             revision="64a2cfc58476a597d7573f83b6fad4dc06cf3a3e" />

    <!-- Required by the current eqe device tree. -->
    <remote name="openeuicc"
            fetch="https://github.com/estkme-group/" />

    <project path="packages/apps/OpenEUICC"
             name="openeuicc"
             remote="openeuicc"
             revision="49e498d4cb331d285e084cc3ab0629ae74ff86fc"
             clone-depth="1"
             sync-s="true" />
</manifest>
